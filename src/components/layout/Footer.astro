---
import { Icon } from 'astro-icon/components';

import ExternalLink from '@/components/ui/ExternalLink.astro';
import type { UiStrings } from '@/i18n/ui';
import type { ContactChannel } from '@/lib/contactLinks';

interface Props {
	t: UiStrings;
	name: string;
	channels: ContactChannel[];
	repoUrl: string;
}

const { t, name, channels, repoUrl } = Astro.props;
const year = new Date().getFullYear();
const linkedChannels = channels.filter((channel) => channel.href);
---

<footer class="border-line border-t py-10">
	<div
		class="container-page text-subtle flex flex-col items-center justify-between gap-5 text-sm sm:flex-row"
	>
		<p>© {year} {name}. {t.footer.madeWith}</p>
		<ul class="flex items-center gap-2">
			{
				linkedChannels.map((channel) => (
					<li>
						<ExternalLink href={channel.href!} class="icon-button" aria-label={channel.label}>
							<Icon name={channel.icon} class="size-4" aria-hidden="true" />
						</ExternalLink>
					</li>
				))
			}
			<li>
				<ExternalLink
					href={repoUrl}
					class="hover:text-accent ml-2 inline-flex items-center gap-1.5 transition-colors"
				>
					<Icon name="mdi:code-braces" class="size-4" aria-hidden="true" />
					{t.footer.sourceCode}
				</ExternalLink>
			</li>
		</ul>
	</div>
</footer>
