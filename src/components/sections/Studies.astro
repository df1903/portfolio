---
import { Icon } from 'astro-icon/components';

import Section from '@/components/ui/Section.astro';
import type { StudyView } from '@/data/portfolio';
import type { UiStrings } from '@/i18n/ui';

interface Props {
	t: UiStrings;
	studies: StudyView[];
}

const { t, studies } = Astro.props;
const statusLabels = { 'in-progress': t.studies.inProgress, completed: t.studies.completed };
---

<Section
	id="estudios"
	eyebrow={`06 · ${t.studies.eyebrow}`}
	title={t.studies.title}
	lead={t.studies.lead}
	tinted
>
	<ul class="grid gap-6 lg:grid-cols-2">
		{
			studies.map((study, index) => (
				<li
					class="card card-interactive p-6 sm:p-8"
					data-reveal
					style={`--reveal-delay:${index * 100}ms`}
				>
					<div class="flex items-start justify-between gap-4">
						<span class="bg-accent/12 text-accent grid size-12 shrink-0 place-items-center rounded-xl">
							<Icon name="mdi:school-outline" class="size-6" aria-hidden="true" />
						</span>
						<span class="chip !border-accent/40 !text-accent">{statusLabels[study.status]}</span>
					</div>
					<h3 class="mt-5 text-xl font-semibold">{study.title}</h3>
					<p class="text-accent mt-1 font-medium">{study.institution}</p>
					<p class="text-subtle mt-1 flex flex-wrap gap-x-4 text-sm">
						{study.location && <span>{study.location}</span>}
						{study.period && <span>{study.period}</span>}
					</p>
					<p class="text-muted mt-4 text-sm">{study.summary}</p>

					{study.highlights.length > 0 && (
						<ul class="text-muted mt-4 space-y-2 text-sm">
							{study.highlights.map((highlight) => (
								<li class="flex gap-3">
									<Icon
										name="mdi:check-circle-outline"
										class="text-accent mt-0.5 size-4 shrink-0"
										aria-hidden="true"
									/>
									{highlight}
								</li>
							))}
						</ul>
					)}

					{study.focusAreas.length > 0 && (
						<ul class="mt-5 flex flex-wrap gap-1.5" aria-label={t.studies.focusAreas}>
							{study.focusAreas.map((area) => (
								<li class="chip !text-xs">{area}</li>
							))}
						</ul>
					)}
				</li>
			))
		}
	</ul>
</Section>
