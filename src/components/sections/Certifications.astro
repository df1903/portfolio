---
import { getImage, Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import FilterBar from '@/components/ui/FilterBar.astro';
import Section from '@/components/ui/Section.astro';
import type { CategoryOption, CertificateView } from '@/data/portfolio';

interface Props {
	certificates: CertificateView[];
	categories: CategoryOption[];
	totalHours: number;
}

/** Con "Todos" activo se muestran estos primero; el resto se despliega con un botón (R7). */
const INITIAL_VISIBLE = 9;
const FULL_IMAGE_WIDTH = 1600;

const { certificates, categories, totalHours } = Astro.props;

const items = await Promise.all(
	certificates.map(async (certificate) => ({
		...certificate,
		full: await getImage({ src: certificate.image, width: FULL_IMAGE_WIDTH, format: 'webp' }),
		caption: [certificate.issuer, certificate.dateLabel].filter(Boolean).join(' · '),
	})),
);
---

<Section
	id="certificaciones"
	eyebrow="07 · Certificaciones"
	title="Aprendizaje continuo"
	lead={`${certificates.length} certificados${totalHours > 0 ? ` y ${totalHours} horas de formación` : ''}. Toca cualquiera para verlo completo.`}
>
	<div data-filter-group data-filter-limit={INITIAL_VISIBLE} data-lightbox-gallery>
		<FilterBar
			label="Filtrar certificados por tema"
			options={categories}
			total={certificates.length}
		/>

		<ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
			{
				items.map((certificate) => (
					<li data-filter-item data-category={certificate.category}>
						<button
							type="button"
							class="card card-interactive group block w-full overflow-hidden text-left"
							data-lightbox-src={certificate.full.src}
							data-lightbox-title={certificate.title}
							data-lightbox-caption={certificate.caption}
						>
							<span class="relative block aspect-[4/3] overflow-hidden bg-white">
								<Image
									src={certificate.image}
									alt={`Certificado: ${certificate.title}`}
									widths={[360, 540, 720]}
									sizes="(min-width: 1024px) 350px, (min-width: 640px) 50vw, 100vw"
									class="size-full object-cover transition-transform duration-700 ease-(--ease-out-soft) group-hover:scale-105"
									loading="lazy"
								/>
								<span class="bg-bg/70 absolute inset-0 grid place-items-center opacity-0 backdrop-blur-[2px] transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">
									<span class="btn btn-primary !py-2 text-sm">
										<Icon name="mdi:magnify" class="size-4" aria-hidden="true" />
										Ver completo
									</span>
								</span>
							</span>
							<span class="block p-4">
								<span class="block leading-snug font-semibold">{certificate.title}</span>
								<span class="text-subtle mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
									{certificate.caption && <span>{certificate.caption}</span>}
									{certificate.hours && (
										<span class="inline-flex items-center gap-1">
											<Icon name="mdi:clock-outline" class="size-3.5" aria-hidden="true" />
											{certificate.hours} h
										</span>
									)}
								</span>
							</span>
						</button>
					</li>
				))
			}
		</ul>

		<div class="mt-8 text-center" data-filter-more-wrapper hidden>
			<button type="button" class="btn btn-ghost" data-filter-more aria-expanded="false">
				<span data-filter-more-label>Ver todos los certificados</span>
				<Icon name="mdi:chevron-down" class="size-4" aria-hidden="true" />
			</button>
		</div>
	</div>
</Section>

<dialog
	class="modal w-[min(64rem,calc(100vw-1.5rem))]"
	data-lightbox
	aria-labelledby="lightbox-title"
>
	<figure class="relative">
		<div class="bg-white">
			<img
				src=""
				alt=""
				class="mx-auto max-h-[72vh] w-auto max-w-full object-contain"
				data-lightbox-image
			/>
		</div>
		<figcaption class="flex items-center justify-between gap-4 p-4 sm:px-6">
			<div class="min-w-0">
				<p id="lightbox-title" class="truncate font-semibold" data-lightbox-heading></p>
				<p class="text-subtle truncate text-sm" data-lightbox-subheading></p>
			</div>
			<div class="flex shrink-0 items-center gap-2">
				<span class="text-subtle mr-1 font-mono text-xs" data-lightbox-counter></span>
				<button
					type="button"
					class="icon-button"
					data-lightbox-prev
					aria-label="Certificado anterior"
				>
					<Icon name="mdi:chevron-left" class="size-5" aria-hidden="true" />
				</button>
				<button
					type="button"
					class="icon-button"
					data-lightbox-next
					aria-label="Certificado siguiente"
				>
					<Icon name="mdi:chevron-right" class="size-5" aria-hidden="true" />
				</button>
				<button type="button" class="icon-button" data-dialog-close aria-label="Cerrar">
					<Icon name="mdi:close" class="size-5" aria-hidden="true" />
				</button>
			</div>
		</figcaption>
	</figure>
</dialog>

<script>
	import '@/scripts/lightbox';
</script>
