---
import { Icon } from 'astro-icon/components';

import ExternalLink from '@/components/ui/ExternalLink.astro';
import Section from '@/components/ui/Section.astro';
import type { UiStrings } from '@/i18n/ui';
import type { ContactChannel } from '@/lib/contactLinks';

interface Props {
	t: UiStrings;
	channels: ContactChannel[];
}

const CARD_CLASS = 'card card-interactive group flex h-full w-full flex-col gap-4 p-6 text-left';

const { t, channels } = Astro.props;
---

<Section
	id="contacto"
	eyebrow={`08 · ${t.contact.eyebrow}`}
	title={t.contact.title}
	lead={t.contact.lead}
	tinted
>
	<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
		{
			channels.map((channel, index) => {
				const body = (
					<Fragment>
						<span class="bg-accent/12 text-accent group-hover:bg-accent group-hover:text-accent-contrast grid size-12 place-items-center rounded-xl transition-colors">
							<Icon name={channel.icon} class="size-6" aria-hidden="true" />
						</span>
						<span>
							<span class="font-display block text-lg font-semibold">{channel.label}</span>
							<span class="text-muted block text-[0.8rem] tracking-tight break-all">
								{channel.handle}
							</span>
						</span>
					</Fragment>
				);
				return (
					<li data-reveal style={`--reveal-delay:${index * 80}ms`}>
						{channel.href ? (
							<ExternalLink
								href={channel.href}
								class={CARD_CLASS}
								data-contact-channel={channel.kind}
							>
								{body}
								<span class="text-accent mt-auto inline-flex items-center gap-1 text-sm font-semibold">
									{t.common.open}
									<Icon
										name="mdi:arrow-top-right"
										class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
										aria-hidden="true"
									/>
								</span>
							</ExternalLink>
						) : (
							// Canal sin enlace directo (usuario de WhatsApp): la tarjeta copia el valor.
							<button
								type="button"
								class={CARD_CLASS}
								data-contact-channel={channel.kind}
								data-copy={channel.copyValue}
								data-copied-label={t.contact.copied}
							>
								{body}
								<span class="text-accent mt-auto inline-flex items-center gap-1 text-sm font-semibold">
									<span data-copy-label aria-live="polite">
										{t.contact.copyUsername}
									</span>
									<Icon name="mdi:content-copy" class="size-4" aria-hidden="true" />
								</span>
							</button>
						)}
					</li>
				);
			})
		}
	</ul>

	<div
		class="card from-accent/10 to-accent-alt/10 mt-8 flex flex-col items-start justify-between gap-5 bg-gradient-to-r p-6 sm:flex-row sm:items-center sm:p-8"
		data-reveal
	>
		<div>
			<h3 class="text-xl font-semibold">{t.contact.askFirstTitle}</h3>
			<p class="text-muted mt-1">{t.contact.askFirstText}</p>
		</div>
		<button type="button" class="btn btn-primary shrink-0" data-chat-open>
			<Icon name="mdi:creation" class="size-4" aria-hidden="true" />
			{t.contact.openAssistant}
		</button>
	</div>
</Section>

<script>
	import '@/scripts/copy';
</script>
