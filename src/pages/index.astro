---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ChatWidget from '@/components/layout/ChatWidget.astro';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import AboutMe from '@/components/sections/AboutMe.astro';
import Certifications from '@/components/sections/Certifications.astro';
import Contact from '@/components/sections/Contact.astro';
import Experience from '@/components/sections/Experience.astro';
import Hero from '@/components/sections/Hero.astro';
import Projects from '@/components/sections/Projects.astro';
import Skills from '@/components/sections/Skills.astro';
import Studies from '@/components/sections/Studies.astro';
import Technologies from '@/components/sections/Technologies.astro';
import { loadPortfolio } from '@/data/portfolio';
import { site } from '@/data/site';

const portfolio = await loadPortfolio();

const stats = [
	{ value: portfolio.projects.length, label: 'Proyectos publicados' },
	{ value: portfolio.technologies.length, suffix: '+', label: 'Tecnologías' },
	{ value: portfolio.certificates.length, label: 'Certificados' },
	{ value: portfolio.certificateHours, suffix: 'h', label: 'De formación continua' },
];

const githubChannel = portfolio.contactChannels.find((channel) => channel.kind === 'github');

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: site.name,
	jobTitle: portfolio.about.headline,
	description: portfolio.about.tagline,
	address: { '@type': 'PostalAddress', addressLocality: site.location },
	alumniOf: portfolio.studies[0]?.institution,
	knowsAbout: portfolio.technologies
		.filter((technology) => technology.featured)
		.map((technology) => technology.name),
	sameAs: portfolio.contactChannels
		.filter((channel) => channel.href.startsWith('https://'))
		.map((channel) => channel.href),
	...(site.url ? { url: site.url } : {}),
};
---

<BaseLayout title={`${site.shortName} — ${site.role}`} structuredData={structuredData}>
	<Header slot="header" initials={site.initials} name={site.shortName} nav={site.nav} />

	<Hero
		name={site.shortName}
		location={site.location}
		about={portfolio.about}
		stats={stats}
		featuredTechnologies={portfolio.technologies.filter((technology) => technology.featured)}
		channels={portfolio.contactChannels}
		cvPath={site.cvPath}
	/>
	<AboutMe about={portfolio.about} />
	<Experience experience={portfolio.experience} />
	<Projects projects={portfolio.projects} categories={portfolio.projectCategories} />
	<Technologies technologies={portfolio.technologies} categories={portfolio.technologyCategories} />
	<Skills skills={portfolio.skills} />
	<Studies studies={portfolio.studies} />
	<Certifications
		certificates={portfolio.certificates}
		categories={portfolio.certificateCategories}
		totalHours={portfolio.certificateHours}
	/>
	<Contact channels={portfolio.contactChannels} />

	<Footer
		slot="footer"
		name={site.name}
		channels={portfolio.contactChannels}
		repoUrl={`${githubChannel?.href ?? 'https://github.com'}/portfolio`}
	/>
	<ChatWidget
		slot="overlays"
		ownerName={site.shortName.split(' ')[0]}
		suggestions={portfolio.knowledge.suggestions}
	/>
</BaseLayout>
