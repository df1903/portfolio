---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@/styles/global.css';

import { site } from '@/data/site';
import { LOCALES, LOCALE_TAGS, DEFAULT_LOCALE, localeRoot, type Locale } from '@/i18n/config';
import { UI } from '@/i18n/ui';

interface Props {
	locale: Locale;
	title: string;
	description: string;
	/** Datos estructurados schema.org (JSON-LD). */
	structuredData?: Record<string, unknown>;
}

const { locale, title, description, structuredData } = Astro.props;
const absolute = (path: string) => (site.url ? new URL(path, site.url).toString() : undefined);
const canonical = absolute(localeRoot(locale));
const ogImage = absolute('/og-image.png');
---

<!doctype html>
<html lang={locale} data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={site.name} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#070a11" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		{canonical && <link rel="canonical" href={canonical} />}
		{
			LOCALES.map((alternate) => (
				<link
					rel="alternate"
					hreflang={alternate}
					href={absolute(localeRoot(alternate)) ?? localeRoot(alternate)}
				/>
			))
		}
		<link
			rel="alternate"
			hreflang="x-default"
			href={absolute(localeRoot(DEFAULT_LOCALE)) ?? localeRoot(DEFAULT_LOCALE)}
		/>

		<meta property="og:type" content="profile" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content={LOCALE_TAGS[locale].replace('-', '_')} />
		{canonical && <meta property="og:url" content={canonical} />}
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

		{
			structuredData && (
				<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			)
		}

		<!-- Antes del primer pintado: aplica el tema guardado (sin parpadeo) y marca que hay JS. -->
		<script is:inline>
			(() => {
				const root = document.documentElement;
				root.classList.add('js');
				try {
					const stored = localStorage.getItem('theme');
					const preferred = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
					root.dataset.theme = stored === 'light' || stored === 'dark' ? stored : preferred;
				} catch {
					/* almacenamiento bloqueado: se queda el tema por defecto */
				}
			})();
		</script>
	</head>
	<body>
		<a
			href="#contenido"
			class="bg-accent text-accent-contrast sr-only z-50 rounded-lg px-4 py-2 font-semibold focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
			>{UI[locale].header.skipToContent}</a
		>
		<slot name="header" />
		<main id="contenido">
			<slot />
		</main>
		<slot name="footer" />
		<slot name="overlays" />
		<script>
			import '@/scripts/reveal';
			import '@/scripts/spotlight';
			import '@/scripts/filters';
		</script>
	</body>
</html>
